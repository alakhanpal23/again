{
  "name": "@again/cache-service",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface Env",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run cf-typegen && npm run typecheck && npm test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=22.20 <23"
  }
}
