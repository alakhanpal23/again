{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "again-cache-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "again-cache",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "again-cache-blobs"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "7 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
